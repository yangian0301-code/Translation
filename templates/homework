<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>查詢股價</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            color: #333;
        }
        header {
            background-color: #4CAF50;
            color: white;
            padding: 10px;
            text-align: center;
        }
        section {
            margin: 20px;
        }
        .form-box {
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        input[type="text"] {
            width: 100%;
            padding: 8px;
        }
        input[type="submit"], input[type="button"] {
            padding: 10px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <header>
        <h1>查詢股價</h1>
    </header>
    <section>
        <div class="form-box">
            <form action="/stock" method="post">
                <label>輸入股票代號:</label><br>
                <input type="text" name="question" value="{{ question }}"><br><br>

                <label>結果:</label><br>
                <input type="text" name="answer" readonly value="{{ answer }}"><br><br>

                <input type="submit" value="查詢">
                <input type="button" value="回首頁" onclick="window.location.href='/'">
            </form>
        </div>
    </section>
</body>
</html>
